{
  "name": "limonify-email-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @limonify/studio dev",
    "dev:cli": "bun run --filter @limonify/email-templates dev",
    "preview": "bun run --filter @limonify/email-templates preview",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter @limonify/email-templates test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0"
}
